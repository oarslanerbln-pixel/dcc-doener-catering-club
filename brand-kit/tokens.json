{
  "$schema": "https://dcc-catering.berlin/schemas/brand-tokens-v1.json",
  "brand": {
    "name": "DCC Döner Catering Club",
    "monogram": "DCC",
    "heritageStamp": "BERLIN · EST. 2026",
    "archetype": "Ember-Cut Architectural Hospitality"
  },
  "typography": {
    "families": {
      "sans": {
        "name": "Space Grotesk",
        "file": "SpaceGrotesk-Var.ttf",
        "weightRange": "300 700",
        "defaultBodyWeight": 400,
        "stack": "'Space Grotesk', ui-sans-serif, system-ui, -apple-system, sans-serif",
        "roles": ["UI body (400)", "Subheads (500-600)", "Architectural display (700, tracking -0.03em)"]
      },
      "monument": {
        "name": "Syne",
        "file": "Syne-Var.ttf",
        "weightRange": "400 800",
        "stack": "'Syne', 'Space Grotesk', sans-serif",
        "roles": ["Club wordmark (800)", "Hero monument accents (700-800, tracking -0.02em)", "Brand seal labels"]
      },
      "serif": {
        "name": "Instrument Serif",
        "files": ["InstrumentSerif-Regular.ttf", "InstrumentSerif-Italic.ttf"],
        "weightRange": "400",
        "styles": ["normal", "italic"],
        "stack": "'Instrument Serif', Georgia, serif",
        "roles": ["Editorial italic contrast on locked baseline (400)"]
      },
      "mono": {
        "name": "JetBrains Mono",
        "file": "JetBrainsMono-Var.ttf",
        "weightRange": "100 800",
        "stack": "'JetBrains Mono', ui-monospace, SFMono-Regular, monospace",
        "roles": ["Step indices 01-04", "Receipt columns & prices", "Micro-labels (+0.12em to +0.18em)", "Metadata"]
      }
    },
    "scaleRatio": [1.0, 1.25, 1.618, 2.618],
    "tabularFeatures": "\"tnum\" 1, \"lnum\" 1",
    "verifiedGlyphSet": "ğüşiöçİĞÜŞÖÇäöüßÄÖÜ€%0123456789"
  },
  "grid": {
    "columns": 12,
    "maxWidthPx": 1280,
    "gutterDesktopPx": 24,
    "gutterMobilePx": 16,
    "goldenRatio": 1.618,
    "safeZones": {
      "landscape16x9": { "marginX": 0.055, "safeTop": 0.075, "safeBottom": 0.085 },
      "portrait9x16": { "marginX": 0.075, "safeTop": 0.14, "safeBottom": 0.21 }
    }
  },
  "motion": {
    "easeExpoOut": "cubic-bezier(0.16, 1, 0.3, 1)",
    "easeQuintInOut": "cubic-bezier(0.83, 0, 0.17, 1)",
    "easeExitSnap": "cubic-bezier(0.7, 0, 0.84, 0)",
    "staggerStepMs": 45,
    "spring": { "stiffness": 185, "damping": 24, "mass": 1.1 }
  },
  "brandSwatches": {
    "obsidian": { "hex": "#0B0A09", "rgb": "11, 10, 9", "hsl": "30, 10%, 4%", "cmyk": "0, 9, 18, 96", "usage": "Primary canvas, mono ink, trailer & metal cladding" },
    "charcoal": { "hex": "#151311", "rgb": "21, 19, 17", "hsl": "30, 11%, 7%", "cmyk": "0, 10, 19, 92", "usage": "Elevated card & receipt surface" },
    "smoke": { "hex": "#1F1C18", "rgb": "31, 28, 24", "hsl": "34, 13%, 11%", "cmyk": "0, 10, 23, 88", "usage": "Subtle surface & hover containers" },
    "warmBone": { "hex": "#F3ECE0", "rgb": "243, 236, 224", "hsl": "38, 44%, 92%", "cmyk": "0, 3, 8, 5", "usage": "Primary light ink on dark, wrap paper & editorial contrast" },
    "parchmentLimestone": { "hex": "#FAF6EF", "rgb": "250, 246, 239", "hsl": "38, 52%, 96%", "cmyk": "0, 2, 4, 2", "usage": "Daylight Limestone canvas & print paper" },
    "burnishedBrass": { "hex": "#D49B54", "rgb": "212, 155, 84", "hsl": "33, 60%, 58%", "cmyk": "0, 27, 60, 17", "usage": "Signature primary metal, sliders & CTA surface" },
    "deepBronze": { "hex": "#7A4710", "rgb": "122, 71, 16", "hsl": "31, 77%, 27%", "cmyk": "0, 42, 87, 52", "usage": "Accessible dark bronze for Limestone UI & print" },
    "emberTerracotta": { "hex": "#C84B27", "rgb": "200, 75, 39", "hsl": "14, 67%, 47%", "cmyk": "0, 63, 81, 22", "usage": "Non-text decorative sear fills, heat glow & emblem accents (>=3:1)" },
    "liftedEmber": { "hex": "#E06440", "rgb": "224, 100, 64", "hsl": "14, 72%, 56%", "cmyk": "0, 55, 71, 12", "usage": "AA-safe ember accent text on dark Obsidian (>=5.35:1)" },
    "kilnTerracotta": { "hex": "#A13618", "rgb": "161, 54, 24", "hsl": "13, 74%, 36%", "cmyk": "0, 66, 85, 37", "usage": "AA-safe terracotta accent text on Limestone (>=6.38:1)" },
    "emeraldClub": { "hex": "#071A14", "rgb": "7, 26, 20", "hsl": "161, 58%, 6%", "cmyk": "73, 0, 23, 90", "usage": "Berlin Club Emerald canvas" },
    "halalHerb": { "hex": "#5D8A66", "rgb": "93, 138, 102", "hsl": "132, 19%, 45%", "cmyk": "33, 0, 26, 46", "usage": "Non-text culinary botanical & Vegan/Halal indicator fill" },
    "liftedHerb": { "hex": "#7AB887", "rgb": "122, 184, 135", "hsl": "133, 30%, 60%", "cmyk": "34, 0, 27, 28", "usage": "AA/AAA-safe herb accent text on Emerald Club (>=6.89:1)" }
  },

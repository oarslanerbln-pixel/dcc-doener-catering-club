        "--brand-accent": "#7AB887",
        "--border-main": "#1E4637",
        "--badge-bg": "#153A2B",
        "--badge-text": "#E5B26B",
        "--btn-text": "#071A14",
        "--navbar-bg": "#071A14EB",
        "--slider-track": "#1E4637",

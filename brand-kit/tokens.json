{
  "$schema": "https://dcc-catering.berlin/schemas/brand-tokens-v1.json",
  "brand": {
    "name": "DCC Döner Catering Club",
    "monogram": "DCC",
    "heritageStamp": "BERLIN · EST. 2026",
    "archetype": "Ember-Cut Architectural Hospitality"
  },
  "typography": {
    "families": {
      "display": {
        "name": "Montserrat",
        "files": ["Montserrat-Medium.ttf", "Montserrat-Bold.ttf", "Montserrat-ExtraBold.ttf"],
        "weightRange": "500 800",
        "stack": "'Montserrat', 'Space Grotesk', ui-sans-serif, system-ui, sans-serif",
        "roles": ["Brand wordmark (800)", "Bold white hero statements (800, tracking -0.028em)", "Section display headings"]
      },
      "sans": {
        "name": "Space Grotesk",
        "file": "SpaceGrotesk-Var.ttf",
        "weightRange": "300 700",
        "defaultBodyWeight": 400,
        "stack": "'Space Grotesk', ui-sans-serif, system-ui, -apple-system, sans-serif",
        "roles": ["UI body (400)", "Subheads (500-600)", "Architectural display (700, tracking -0.03em)"]
      },
      "monument": {
        "name": "Syne",
        "file": "Syne-Var.ttf",
        "weightRange": "400 800",
        "stack": "'Syne', 'Space Grotesk', sans-serif",
        "roles": ["Brand wordmark (800)", "Architectural accents (700-800, tracking -0.02em)", "Brand seal labels"]
      },
      "serif": {
        "name": "Instrument Serif",
        "files": ["InstrumentSerif-Regular.ttf", "InstrumentSerif-Italic.ttf"],
        "weightRange": "400",
        "styles": ["normal", "italic"],
        "stack": "'Instrument Serif', Georgia, serif",
        "roles": ["Editorial italic contrast on locked baseline (400)"]
      },
      "mono": {
        "name": "JetBrains Mono",
        "file": "JetBrainsMono-Var.ttf",
        "weightRange": "100 800",
        "stack": "'JetBrains Mono', ui-monospace, SFMono-Regular, monospace",
        "roles": ["Step indices 01-04", "Receipt columns & prices", "Micro-labels (+0.12em to +0.18em)", "Metadata"]
      }
    },
    "scaleRatio": [1.0, 1.25, 1.618, 2.618],
    "tabularFeatures": "\"tnum\" 1, \"lnum\" 1",
    "verifiedGlyphSet": "ğüşiöçİĞÜŞÖÇäöüßÄÖÜ€%0123456789"
  },
  "grid": {
    "columns": 12,
    "maxWidthPx": 1280,
    "gutterDesktopPx": 24,
    "gutterMobilePx": 16,
    "goldenRatio": 1.618,
    "safeZones": {
      "landscape16x9": { "marginX": 0.055, "safeTop": 0.075, "safeBottom": 0.085 },
      "portrait9x16": { "marginX": 0.075, "safeTop": 0.14, "safeBottom": 0.21 }
    }
  },
  "motion": {
    "easeExpoOut": "cubic-bezier(0.16, 1, 0.3, 1)",
    "easeQuintInOut": "cubic-bezier(0.83, 0, 0.17, 1)",
    "easeExitSnap": "cubic-bezier(0.7, 0, 0.84, 0)",
    "staggerStepMs": 45,
    "spring": { "stiffness": 185, "damping": 24, "mass": 1.1 }
  },
  "brandSwatches": {
    "obsidian": { "hex": "#060606", "rgb": "6, 6, 6", "hsl": "0, 0%, 2%", "cmyk": "0, 0, 0, 98", "usage": "Primary pure-black canvas, mono ink, trailer & metal cladding" },
    "charcoal": { "hex": "#0D0F0E", "rgb": "13, 15, 14", "hsl": "150, 7%, 5%", "cmyk": "13, 0, 7, 94", "usage": "Elevated frameless card & receipt surface" },
    "smoke": { "hex": "#141816", "rgb": "20, 24, 22", "hsl": "150, 9%, 9%", "cmyk": "17, 0, 8, 91", "usage": "Subtle surface & hover containers" },
    "pureWhite": { "hex": "#FFFFFF", "rgb": "255, 255, 255", "hsl": "0, 0%, 100%", "cmyk": "0, 0, 0, 0", "usage": "Primary bold Montserrat headings & light ink on pure black" },
    "parchmentLimestone": { "hex": "#FAF6EF", "rgb": "250, 246, 239", "hsl": "38, 52%, 96%", "cmyk": "0, 2, 4, 2", "usage": "Light Rechner contrast canvas & butcher wrap paper" },
    "burnishedBrass": { "hex": "#D4A853", "rgb": "212, 168, 83", "hsl": "40, 60%, 58%", "cmyk": "0, 21, 61, 17", "usage": "Champagne Gold primary metal, sliders & CTA surface" },
    "deepBronze": { "hex": "#9A7226", "rgb": "154, 114, 38", "hsl": "39, 60%, 38%", "cmyk": "0, 26, 75, 40", "usage": "Accessible dark gold for Light Rechner UI & print" },
    "berlinEmerald": { "hex": "#2BC48A", "rgb": "43, 196, 138", "hsl": "157, 64%, 47%", "cmyk": "78, 0, 30, 23", "usage": "Gold-to-Emerald gradient endpoint & Halal indicator" },
    "deepEmerald": { "hex": "#18A974", "rgb": "24, 169, 116", "hsl": "158, 75%, 38%", "cmyk": "86, 0, 31, 34", "usage": "AA-safe emerald accent text on Obsidian & Light Rechner" },
    "silverMuted": { "hex": "#A8B2AE", "rgb": "168, 178, 174", "hsl": "156, 7%, 68%", "cmyk": "6, 0, 2, 30", "usage": "Secondary legible copy on pure black" },
    "emeraldClub": { "hex": "#111A16", "rgb": "17, 26, 22", "hsl": "153, 21%, 8%", "cmyk": "35, 0, 15, 90", "usage": "Obsidian Emerald subtle badge surface" }
  },
  "themes": {
    "obsidian": {
      "className": "theme-obsidian",
      "isDefault": true,
      "label": { "de": "Obsidian & Gold", "en": "Obsidian & Gold", "tr": "Obsidyen & Altın" },
      "tokens": {
        "--bg-main": "#060606",
        "--bg-card": "#0D0F0E",
        "--bg-subtle": "#141816",
        "--bg-contrast": "#FFFFFF",
        "--text-primary": "#FFFFFF",
        "--text-secondary": "#A8B2AE",
        "--text-muted": "#707A76",
        "--brand-primary": "#D4A853",
        "--brand-hover": "#E6BE6A",
        "--brand-accent": "#18A974",
        "--accent-emerald": "#2BC48A",
        "--border-main": "#1A1F1D",
        "--badge-bg": "#111A16",
        "--badge-text": "#E6BE6A",
        "--btn-text": "#050505",
        "--navbar-bg": "#060606E0",
        "--slider-track": "#1E2422",
        "--slider-thumb": "#D4A853",
        "--receipt-bg": "#0A0C0B",
        "--receipt-text": "#FFFFFF",
        "--receipt-accent": "#D4A853"
      }
    },
    "limestone": {
      "className": "theme-limestone",
      "isDefault": false,
      "label": { "de": "Ivory & Gold (Rechner)", "en": "Ivory & Gold (Rechner)", "tr": "Fildişi & Altın (Hesaplayıcı)" },
      "tokens": {
        "--bg-main": "#FAF6EF",
        "--bg-card": "#FFFFFF",
        "--bg-subtle": "#F0EAE0",
        "--bg-contrast": "#060606",
        "--text-primary": "#060606",
        "--text-secondary": "#2C3330",
        "--text-muted": "#5A625E",
        "--brand-primary": "#9A7226",
        "--brand-hover": "#7A581B",
        "--brand-accent": "#148F63",
        "--border-main": "#E2DDD3",
        "--badge-bg": "#EFE8DA",
        "--badge-text": "#7A581B",
        "--btn-text": "#FAF6EF",
        "--navbar-bg": "#FAF6EFF0",
        "--slider-track": "#DDD6C8",
        "--slider-thumb": "#9A7226",
        "--receipt-bg": "#FFFFFF",
        "--receipt-text": "#060606",
        "--receipt-accent": "#9A7226"
      }
    },
    "emerald-club": {
      "className": "theme-emerald-club",
      "isDefault": false,
      "label": { "de": "Obsidian Smaragd", "en": "Obsidian Emerald", "tr": "Obsidyen Zümrüt" },
      "tokens": {
        "--bg-main": "#060606",
        "--bg-card": "#0D0F0E",
        "--bg-subtle": "#141816",
        "--bg-contrast": "#FFFFFF",
        "--text-primary": "#FFFFFF",
        "--text-secondary": "#A8B2AE",
        "--text-muted": "#707A76",
        "--brand-primary": "#D4A853",
        "--brand-hover": "#E6BE6A",
        "--brand-accent": "#2BC48A",
        "--border-main": "#1A1F1D",
        "--badge-bg": "#111A16",
        "--badge-text": "#E6BE6A",
        "--btn-text": "#060606",
        "--navbar-bg": "#060606EB",
        "--slider-track": "#1E2422",
        "--slider-thumb": "#D4A853",
        "--receipt-bg": "#0A0C0B",
        "--receipt-text": "#FFFFFF",
        "--receipt-accent": "#D4A853"
      }
    }
  },
  "wcagContrast": {
    "textPrimaryOnBgMain": { "obsidian": 16.85, "limestone": 18.36, "emeraldClub": 15.33 },
    "textPrimaryOnBgCard": { "obsidian": 15.78, "limestone": 19.47, "emeraldClub": 13.65 },
    "textPrimaryOnBgSubtle": { "obsidian": 14.45, "limestone": 16.23, "emeraldClub": 11.40 },
    "textSecondaryOnBgMain": { "obsidian": 11.84, "limestone": 13.54, "emeraldClub": 13.05 },
    "textMutedOnBgMain": { "obsidian": 7.75, "limestone": 7.12, "emeraldClub": 7.96 },

        "--btn-text": "#FAF6EF",
        "--navbar-bg": "#FAF6EFF0",
        "--slider-track": "#DCD2C1",
        "--slider-thumb": "#7A4710",
        "--receipt-bg": "#151311",
        "--receipt-text": "#F3ECE0",
        "--receipt-accent": "#D49B54"
      }
    },
    "emerald-club": {
      "className": "theme-emerald-club",
      "isDefault": false,
      "label": { "de": "Club Smaragd", "en": "Emerald Club", "tr": "Zümrüt Kulüp" },
      "tokens": {
        "--bg-main": "#071A14",
        "--bg-card": "#0C261D",
        "--bg-subtle": "#133529",
        "--bg-contrast": "#F3ECE0",
